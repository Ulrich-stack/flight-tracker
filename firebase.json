{
  "hosting": [
    {
      "target": "flight-tracker",
      "public": "dist/flight-tracker/browser",
      "predeploy": ["npm run build"],
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [
        {
          "source": "/opensky/**",
          "function": { "functionId": "opensky", "region": "europe-west1" }
        },
        { "source": "**", "destination": "/index.html" }
      ],
      "headers": [
        {
          "source": "**/*.@(js|css)",
          "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
        }
      ]
    }
  ],
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "ignore": ["node_modules", ".git", "*.log", ".env.example"]
    }
  ],
  "firestore": {
    "rules": "firestore.rules"
  }
}
